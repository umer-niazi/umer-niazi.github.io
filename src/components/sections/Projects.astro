---
import ProjectCard from '../ProjectCard.astro';
import { site } from '../../data/site.ts';
import { projects, secondaryProjects } from '../../data/projects.ts';
---

<section id="projects" class="scroll-mt-24 mt-16 sm:mt-24" aria-labelledby="projects-heading">
  <div class="flex flex-col gap-2">
    <h2 id="projects-heading" class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">{site.projectsSection.title}</h2>
    <p class="max-w-prose text-sm leading-relaxed text-body">
      {site.projectsSection.description}
    </p>
  </div>

  <div class="mt-10 grid grid-cols-1 gap-y-12 sm:grid-cols-2 sm:gap-x-10 sm:gap-y-14">
    {projects.map((project, idx) => (
      <ProjectCard {...project} index={idx + 1} headingLevel="h3" />
    ))}
  </div>

  <div class="mt-16 sm:mt-20">
    <h3 class="text-xl font-bold tracking-tight text-ink">{site.projectsSection.secondaryTitle}</h3>
    <div class="mt-8 grid grid-cols-1 gap-y-12 sm:grid-cols-2 sm:gap-x-10 sm:gap-y-14">
      {secondaryProjects.map((project, idx) => (
        <ProjectCard
          {...project}
          index={projects.length + idx + 1}
          category="EXPERIMENT"
          headingLevel="h4"
        />
      ))}
    </div>
  </div>
</section>
