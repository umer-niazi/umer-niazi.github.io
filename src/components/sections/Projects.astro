---
import ProjectCard from '../ProjectCard.astro';
import { site } from '../../data/site.ts';
import { projects } from '../../data/projects.ts';
---

<section id="projects" class="scroll-mt-24 mt-16 sm:mt-24" aria-labelledby="projects-heading">
  <div class="flex flex-col gap-2">
    <h2 id="projects-heading" class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">{site.projectsSection.title}</h2>
    <p class="max-w-prose text-sm sm:text-base leading-relaxed text-body">
      {site.projectsSection.description}
    </p>
  </div>

  <div class="mt-10 grid grid-cols-1 gap-y-12 md:grid-cols-2 sm:gap-x-10 sm:gap-y-14">
    {projects.map((project, idx) => (
      <ProjectCard {...project} index={idx + 1} headingLevel="h3" />
    ))}
  </div>
</section>
