---
import { site } from '../../data/site.ts';
---

<section id="about" class="scroll-mt-24 mt-16 sm:mt-24" aria-labelledby="about-heading">
  <div class="flex flex-col gap-2">
    <h2 id="about-heading" class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">{site.aboutSection.title}</h2>
  </div>

  <div class="mt-6 flex max-w-[60ch] flex-col gap-4">
    <p class="text-sm sm:text-base leading-relaxed text-body">
      {site.bio.summary}
    </p>
    {
      site.bio.about.map((paragraph) => (
        <p class="text-sm sm:text-base leading-relaxed text-body">
          {paragraph}
        </p>
      ))
    }
  </div>

  <p class="mt-7">
    <a href="#contact" class="text-sm text-accent underline-offset-4 hover:underline transition-colors duration-150">
      {site.aboutSection.emailCta}
    </a>
  </p>

  <div class="mt-16 border-t border-border pt-8" aria-labelledby="education-heading">
    <h3 id="education-heading" class="text-xl font-semibold tracking-tight text-ink">{site.aboutSection.educationTitle}</h3>
    <div class="mt-4 flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
      <div>
        <p class="text-sm font-semibold text-ink">
          {site.education.degree}
        </p>
        <p class="mt-0.5 font-mono text-xs text-muted">{site.education.school}</p>
      </div>
      <p class="font-mono text-xs text-muted">{site.education.period}</p>
    </div>
  </div>

  <div class="mt-14 sm:mt-16">
    <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 sm:gap-10">
      <div>
        <h3 id="skills-heading" class="text-xl font-semibold tracking-tight text-ink">{site.aboutSection.skillsTitle}</h3>
        <div class="mt-6 flex flex-col gap-6">
          {
            site.skills.map((group) => (
              <div class="flex flex-col gap-2.5">
                <span class="font-mono text-[11px] font-medium uppercase tracking-wider text-muted">{group.category}</span>
                <ul class="flex flex-wrap gap-2">
                  {group.items.map((skill) => (
                    <li class="cursor-default select-none rounded-none border border-border bg-transparent px-2.5 py-1 font-mono text-xs text-body transition-colors duration-150 hover:border-accent hover:bg-accent/[0.02] hover:text-ink">
                      {skill}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>

      <div>
        <h3 id="interests-heading" class="text-xl font-semibold tracking-tight text-ink">{site.aboutSection.interestsTitle}</h3>
        <ul class="mt-6 flex flex-col gap-3 font-mono text-xs text-body">
          {
            site.interests.map((interest) => (
              <li class="group flex items-baseline gap-2.5">
                <span class="text-[10px] text-accent transition-transform duration-150 group-hover:translate-x-0.5" aria-hidden="true">
                  →
                </span>
                <span class="text-body transition-colors duration-150 group-hover:text-ink">{interest}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="mt-14 sm:mt-16" aria-labelledby="environment-heading">
    <h3 id="environment-heading" class="text-xl font-semibold tracking-tight text-ink">{site.aboutSection.setupTitle}</h3>
    <p class="mt-1 text-xs text-muted">{site.aboutSection.setupSubtitle}</p>

    <dl class="mt-6 grid grid-cols-1 gap-y-4 sm:grid-cols-2 sm:gap-x-10 sm:gap-y-6">
      {
        site.environment.map((group) => (
          <div class="flex flex-col gap-1">
            <dt class="font-mono text-[11px] font-medium uppercase tracking-wider text-muted">
              {group.category}
            </dt>
            <dd class="font-mono text-sm leading-relaxed text-body">
              {
                group.category === 'Linux distribution' ? (
                  group.items.map((item, idx) => (
                    <>
                      <span class:list={['whitespace-nowrap', item.includes('(current)') && 'text-ink']}>{item}</span>
                      {idx < group.items.length - 1 && ' → '}
                    </>
                  ))
                ) : (
                  group.items.join(' · ')
                )
              }
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
