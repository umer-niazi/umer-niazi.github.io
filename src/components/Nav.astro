---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site.ts';

const pathname = Astro.url.pathname.replace(/\/index\.html$/, '') || '/';
const isHome = pathname === '/';

const links = [
  ...site.nav.map((link) => ({
    href: isHome ? link.href : `/${link.href}`,
    label: link.label,
    external: false,
  })),
  { href: site.resumeUrl, label: 'resume', external: true },
];
---

<header id="top" class="sticky top-0 z-40 border-b border-border bg-bg py-4 sm:py-5">
  <div class="flex w-full items-center justify-between">
    <a href={isHome ? '#top' : '/'} class="group py-2 text-base font-semibold tracking-tight text-ink no-underline">
      <span class="text-faint transition-colors duration-150 group-hover:text-accent font-normal">~/</span><span class="transition-colors duration-150 group-hover:text-accent">umer</span>
    </a>

    <div class="flex items-center gap-2 sm:gap-6">
      <nav aria-label="Primary" class="hidden items-center gap-6 text-base sm:flex" id="nav-desktop">
        {
          links.map((link) => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              data-nav-link={!link.external ? link.label : undefined}
              class="inline-flex items-center gap-1 px-2 py-2 underline-offset-4 text-muted hover:text-accent hover:underline transition-colors duration-150"
            >
              <span>{link.label}</span>
              {link.external && (
                <Icon name="tabler:arrow-up-right" class="h-3.5 w-3.5 opacity-70" aria-hidden="true" />
              )}
            </a>
          ))
        }
      </nav>

      <button
        type="button"
        id="theme-toggle"
        aria-label="Toggle theme"
        class="flex h-11 w-11 items-center justify-center rounded-none text-muted transition-colors duration-150 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        <div class="relative flex h-5 w-5 items-center justify-center">
          <Icon name="tabler:moon" class="theme-icon-moon icon-swap absolute h-5 w-5" aria-hidden="true" />
          <Icon name="tabler:sun" class="theme-icon-sun icon-swap absolute h-5 w-5" aria-hidden="true" />
        </div>
      </button>

      <button
        type="button"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-mobile"
        aria-label="Open menu"
        class="-mr-1.5 flex h-12 w-12 items-center justify-center rounded-none text-muted transition-colors duration-150 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent sm:hidden"
      >
        <div class="relative flex h-6 w-6 items-center justify-center">
          <Icon name="tabler:menu-2" data-icon="open" class="icon-swap absolute h-6 w-6" aria-hidden="true" />
          <Icon name="tabler:x" data-icon="close" class="icon-swap icon-hidden absolute h-6 w-6" aria-hidden="true" />
        </div>
      </button>
    </div>
  </div>

  <nav
    id="nav-mobile"
    aria-label="Primary"
    inert
    class="absolute left-0 top-full flex w-full flex-col gap-2 border-b border-border bg-bg pb-4 pt-2 text-base sm:hidden"
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
          data-nav-link={!link.external ? link.label : undefined}
          class="flex items-center justify-between rounded-none px-5 py-3.5 underline-offset-4 text-muted hover:text-accent hover:underline transition-colors duration-150"
        >
          <span>{link.label}</span>
          {link.external && (
            <Icon name="tabler:arrow-up-right" class="h-4 w-4 opacity-70" aria-hidden="true" />
          )}
        </a>
      ))
    }
  </nav>
</header>

<script>
  function initThemeToggle() {
    const toggle = document.getElementById('theme-toggle');
    if (!toggle) return;

    toggle.addEventListener('click', () => {
      const element = document.documentElement;
      const isDark =
        element.classList.contains('dark') ||
        (!element.classList.contains('light') && window.matchMedia('(prefers-color-scheme: dark)').matches);
      const nextIsDark = !isDark;
      element.classList.toggle('dark', nextIsDark);
      element.classList.toggle('light', !nextIsDark);
      try {
        localStorage.setItem('theme', nextIsDark ? 'dark' : 'light');
      } catch (e) {}
    });
  }

  function initNavToggle() {
    const toggle = document.getElementById('nav-toggle');
    const panel = document.getElementById('nav-mobile');
    if (!toggle || !panel) return;

    const iconOpen = toggle.querySelector('[data-icon="open"]');
    const iconClose = toggle.querySelector('[data-icon="close"]');

    function setOpen(open: boolean) {
      if (!toggle || !panel) return;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      panel.classList.toggle('nav-mobile-open', open);
      panel.toggleAttribute('inert', !open);

      iconOpen?.classList.toggle('icon-hidden', open);
      iconClose?.classList.toggle('icon-hidden', !open);
    }

    toggle.addEventListener('click', () => {
      const isOpening = toggle.getAttribute('aria-expanded') !== 'true';
      setOpen(isOpening);

      if (isOpening) {
        requestAnimationFrame(() => {
          panel.querySelector('a')?.focus();
        });
      } else {
        toggle.focus();
      }
    });

    panel.addEventListener('click', (e) => {
      if (e.target instanceof HTMLElement && e.target.closest('a')) setOpen(false);
    });

    document.addEventListener('click', (e) => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      if (e.target instanceof Node && !toggle.contains(e.target) && !panel.contains(e.target)) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    window.matchMedia('(min-width: 640px)').addEventListener('change', (e) => {
      if (e.matches && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
      }
    });
  }

  function initScrollSpy() {
    const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
    if (!navLinks.length) return;

    const sectionIds = ['projects', 'about', 'contact'];
    const sections = sectionIds
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    if (!sections.length) return;

    function setActive(activeId: string) {
      navLinks.forEach((link) => {
        const isActive = link.getAttribute('data-nav-link') === activeId;
        link.classList.toggle('font-medium', isActive);
        link.classList.toggle('text-accent', isActive);
        link.classList.toggle('underline', isActive);
        link.classList.toggle('text-muted', !isActive);
        link.classList.toggle('hover:text-accent', !isActive);
        link.classList.toggle('hover:underline', !isActive);

        if (isActive) {
          link.setAttribute('aria-current', 'page');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    }

    let ticking = false;
    let manualScrollTimer: number | undefined;

    function onScroll() {
      if (manualScrollTimer !== undefined || ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        if (manualScrollTimer !== undefined) return;

        const scrollY = window.scrollY;
        const scrollHeight = document.documentElement.scrollHeight;
        const clientHeight = window.innerHeight;

        if (scrollY < 120) {
          setActive('');
          return;
        }

        if (scrollY + clientHeight >= scrollHeight - 80) {
          setActive('contact');
          return;
        }

        const headerOffset = 140;
        let currentSectionId = '';

        for (const section of sections) {
          if (section.getBoundingClientRect().top <= headerOffset) {
            currentSectionId = section.id;
          } else {
            break;
          }
        }

        setActive(currentSectionId);
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (!href || href === '#') return;
        const targetId = href.slice(1);
        if (targetId === 'top') {
          e.preventDefault();
          setActive('');
          window.clearTimeout(manualScrollTimer);
          manualScrollTimer = window.setTimeout(() => {
            manualScrollTimer = undefined;
          }, 800);
          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
          history.pushState(null, '', '#top');
          return;
        }
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          e.preventDefault();
          setActive(targetId);
          window.clearTimeout(manualScrollTimer);
          manualScrollTimer = window.setTimeout(() => {
            manualScrollTimer = undefined;
          }, 800);
          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          targetEl.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth' });
          history.pushState(null, '', `#${targetId}`);
        }
      });
    });
  }

  function init() {
    initThemeToggle();
    initNavToggle();
    initScrollSpy();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>