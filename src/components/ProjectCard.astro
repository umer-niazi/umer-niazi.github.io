---
import { Icon } from 'astro-icon/components';

interface Props {
  name: string;
  description: string;
  summary?: string;
  stack?: string[];
  outcome?: string[];
  features?: string[];
  demoUrl?: string | null;
  demoLabel?: string;
  sourceUrl?: string | null;
  headingLevel?: 'h2' | 'h3' | 'h4';
  variant?: 'detailed' | 'minimal';
  index?: number | string;
  category?: string;
  featured?: boolean;
}

const {
  name,
  description,
  summary,
  stack,
  outcome,
  features,
  demoUrl,
  demoLabel = 'Demo',
  sourceUrl,
  headingLevel = 'h3',
  variant = 'detailed',
  index,
  category,
  featured,
} = Astro.props;

const Heading = headingLevel;
const formattedIndex = index != null ? String(index).padStart(2, '0') : undefined;
const primaryUrl = demoUrl || sourceUrl;
const categoryLabel = category || (featured ? 'FEATURED' : 'PROJECT');
---

<article class="group relative flex flex-col border-t border-border pt-6 transition-colors duration-200 hover:border-accent">
  <div class="flex items-center justify-between text-xs font-mono">
    <span class="text-[11px] font-medium tracking-wider uppercase text-muted">
      {formattedIndex ? `${formattedIndex} / ` : ''}{categoryLabel}
    </span>
  </div>

  <div class="mt-3">
    <Heading class="text-base sm:text-lg font-semibold tracking-tight text-ink">
      {primaryUrl ? (
        <a
          href={primaryUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-ink no-underline transition-colors duration-150 group-hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          <span>{name}</span>
          <Icon
            name="tabler:arrow-up-right"
            class="h-4 w-4 text-muted transition-all duration-150 ease-out group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent"
            aria-hidden="true"
          />
        </a>
      ) : (
        <span class="transition-colors duration-150 group-hover:text-accent">{name}</span>
      )}
    </Heading>
  </div>

  <p class="mt-3 text-sm leading-relaxed text-body">
    {variant === 'minimal' ? (summary || description) : description}
  </p>

  {(outcome?.length || stack?.length || features?.length) && (
    <dl class="mt-6 flex flex-col gap-2 border-t border-border/40 pt-4 text-xs font-mono">
      {outcome && outcome.length > 0 && (
        <div class="grid grid-cols-[4.5rem_1fr] sm:grid-cols-[5rem_1fr] items-baseline gap-2">
          <dt class="text-[11px] uppercase tracking-wider text-muted font-medium">Outcome</dt>
          <dd class="text-ink leading-relaxed">
            {outcome.join(' · ')}
          </dd>
        </div>
      )}

      {stack && stack.length > 0 && (
        <div class="grid grid-cols-[4.5rem_1fr] sm:grid-cols-[5rem_1fr] items-baseline gap-2">
          <dt class="text-[11px] uppercase tracking-wider text-muted font-medium">Stack</dt>
          <dd class="text-faint leading-relaxed">
            {variant === 'minimal' ? stack.slice(0, 4).join(' · ') : stack.join(' · ')}
          </dd>
        </div>
      )}

      {features && features.length > 0 && (
        <div class="grid grid-cols-[4.5rem_1fr] sm:grid-cols-[5rem_1fr] items-baseline gap-2">
          <dt class="text-[11px] uppercase tracking-wider text-muted font-medium">Features</dt>
          <dd class="text-muted leading-relaxed">
            {features.join(' · ')}
          </dd>
        </div>
      )}
    </dl>
  )}

  {(demoUrl || sourceUrl) && (
    <div class="mt-auto pt-6 flex items-center gap-5 text-xs font-mono">
      {demoUrl && (
        <a
          href={demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 rounded-none text-accent underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          <span>{demoLabel}</span>
          <Icon name="tabler:external-link" class="h-3.5 w-3.5" aria-hidden="true" />
        </a>
      )}
      {sourceUrl && (
        <a
          href={sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 rounded-none text-muted hover-text-accent underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          <span>Source</span>
          <Icon name="tabler:brand-github" class="h-3.5 w-3.5" aria-hidden="true" />
        </a>
      )}
    </div>
  )}
</article>