---
import { Icon } from 'astro-icon/components';

interface Props {
  name: string;
  description: string;
  stack?: string[];
  outcome?: string[];
  demoUrl?: string | null;
  demoLabel?: string;
  sourceUrl?: string | null;
  headingLevel?: 'h2' | 'h3' | 'h4';
  index?: number | string;
  category?: string;
}

const {
  name,
  description,
  stack,
  outcome,
  demoUrl,
  demoLabel = 'Demo',
  sourceUrl,
  headingLevel = 'h3',
  index,
  category,
} = Astro.props;

const Heading = headingLevel;
const formattedIndex = index != null ? String(index).padStart(2, '0') : undefined;
const categoryLabel = category;
---

<article class="relative flex flex-col border-t border-border pt-6">
  <div class="flex items-center justify-between text-xs font-mono">
    <span class="text-[11px] font-medium tracking-wider uppercase text-muted">
      {[formattedIndex, categoryLabel].filter(Boolean).join(' / ')}
    </span>
  </div>

  <div class="mt-3">
    <Heading class="text-base sm:text-lg font-semibold tracking-tight text-ink">
      {name}
    </Heading>
  </div>

  <p class="mt-3 max-w-[60ch] text-sm leading-relaxed text-body">
    {description}
  </p>

  {(outcome?.length || stack?.length) && (
    <dl class="mt-6 flex flex-col gap-2 text-xs font-mono">
      {outcome && outcome.length > 0 && (
        <div class="grid grid-cols-[4.5rem_1fr] sm:grid-cols-[5rem_1fr] items-baseline gap-2">
          <dt class="text-[11px] uppercase tracking-wider text-muted font-medium">Outcome</dt>
          <dd class="text-ink leading-relaxed">
            {outcome.join(' · ')}
          </dd>
        </div>
      )}

      {stack && stack.length > 0 && (
        <div class="grid grid-cols-[4.5rem_1fr] sm:grid-cols-[5rem_1fr] items-baseline gap-2">
          <dt class="text-[11px] uppercase tracking-wider text-muted font-medium">Stack</dt>
          <dd class="text-body leading-relaxed">
            {stack.join(' · ')}
          </dd>
        </div>
      )}
    </dl>
  )}

  {(demoUrl || sourceUrl) && (
    <div class="mt-auto pt-6 flex items-center gap-5 text-xs font-mono">
      {demoUrl && (
        <a
          href={demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 rounded-none py-1 text-accent underline-offset-4 hover:underline transition-colors duration-150"
        >
          <span>{demoLabel}</span>
          <Icon name="tabler:external-link" class="h-3.5 w-3.5" aria-hidden="true" />
        </a>
      )}
      {sourceUrl && (
        <a
          href={sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 rounded-none py-1 text-muted hover:text-accent underline-offset-4 hover:underline transition-colors duration-150"
        >
          <span>Source</span>
          <Icon name="tabler:brand-github" class="h-3.5 w-3.5" aria-hidden="true" />
        </a>
      )}
    </div>
  )}
</article>