---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.ts';
import { skills } from '../data/skills.ts';
import { environment } from '../data/environment.ts';
---

<Base title="About" description={`About ${site.name}.`}>
  <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">About</h1>

  <div class="mt-6 flex max-w-[60ch] flex-col gap-4">
    {
      site.bio.about.map((paragraph, idx) => (
        <p class={idx === 0 ? 'text-base leading-relaxed text-ink' : 'text-sm leading-relaxed text-body'}>
          {paragraph}
        </p>
      ))
    }
  </div>

  <p class="mt-5 text-sm">
    <a href={`mailto:${site.email}`} class="text-sm text-accent underline-offset-4 hover:underline">
      Email me &rarr;
    </a>
  </p>

  <!-- Education -->
  <section class="mt-16 border-t border-border pt-8" aria-labelledby="education-heading">
    <h2 id="education-heading" class="text-xl font-semibold tracking-tight text-ink">Education</h2>
    <div class="mt-4 flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
      <div>
        <p class="text-sm font-semibold text-ink">
          {site.education.degree}
        </p>
        <p class="mt-0.5 font-mono text-xs text-faint">{site.education.school}</p>
      </div>
      <p class="font-mono text-xs text-accent">{site.education.period}</p>
    </div>
  </section>

  <!-- Skills & Interests -->
  <div class="mt-16 border-t border-border pt-8">
    <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 sm:gap-10">
      <!-- Skills as Architectural Specimen Tags -->
      <section aria-labelledby="skills-heading">
        <h2 id="skills-heading" class="text-xl font-semibold tracking-tight text-ink">Skills</h2>
        <div class="mt-6 flex flex-col gap-6">
          {
            skills.map((group) => (
              <div class="flex flex-col gap-2.5">
                <span class="font-mono text-[11px] font-medium uppercase tracking-wider text-faint">{group.category}</span>
                <ul class="flex flex-wrap gap-2">
                  {group.items.map((skill) => (
                    <li class="cursor-default select-none rounded-none border border-border bg-transparent px-2.5 py-1 font-mono text-xs text-body transition-colors duration-150 hover:border-accent hover:bg-accent/[0.02] hover:text-ink">
                      {skill}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Interests -->
      <section aria-labelledby="interests-heading">
        <h2 id="interests-heading" class="text-xl font-semibold tracking-tight text-ink">Interests</h2>
        <ul class="mt-6 flex flex-col gap-3 font-mono text-xs text-body">
          {
            site.interests.map((interest) => (
              <li class="group flex items-baseline gap-2.5">
                <span class="text-[10px] text-accent transition-transform duration-150 group-hover:translate-x-0.5" aria-hidden="true">
                  →
                </span>
                <span class="text-body transition-colors duration-150 group-hover:text-ink">{interest}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>

  <!-- Setup -->
  <section class="mt-16 border-t border-border pt-8" aria-labelledby="environment-heading">
    <h2 id="environment-heading" class="text-xl font-semibold tracking-tight text-ink">Setup</h2>
    <p class="mt-1 text-xs text-muted">What I actually build with, day to day.</p>

    <dl class="mt-6 grid grid-cols-1 gap-y-4 sm:grid-cols-2 sm:gap-x-10 sm:gap-y-6">
      {
        environment.map((group) => (
          <div class="group flex flex-col gap-1 border-t border-border/40 pt-3 transition-colors duration-150 hover:border-accent">
            <dt class="font-mono text-[11px] font-medium uppercase tracking-wider text-faint transition-colors duration-150 group-hover:text-accent">
              {group.category}
            </dt>
            <dd class="font-mono text-sm leading-relaxed text-body transition-colors duration-150 group-hover:text-ink">
              {group.items.join(' · ')}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</Base>